{
  "name": "supervisor-conveyance-root",
  "version": "1.0.0",
  "private": true,
  "description": "Supervisor Location Monitoring & Bike Conveyance Management System",
  "scripts": {
    "start": "node server/src/index.js",
    "build": "npm --prefix server install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "app": "npm --prefix supervisor-app run dev",
    "app:build": "npm --prefix supervisor-app run cap:build",
    "app:apk": "cd supervisor-app/android && .\\gradlew.bat assembleDebug",
    "seed": "npm --prefix server run seed",
    "install:all": "npm --prefix server install && npm --prefix client install && npm --prefix supervisor-app install",
    "dev": "node run-dev.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.0.5",
    "xlsx": "^0.18.5"
  },
  "workspaces": [
    "client"
  ]
}
